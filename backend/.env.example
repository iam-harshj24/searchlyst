PORT=3000
# PostgreSQL (production). For local SQLite use: file:./dev.db
DATABASE_URL=postgresql://user:password@localhost:5432/searchlyst
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-secret-key-change-this-in-production
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_app_password
NOTIFICATION_EMAIL=notifications@example.com
NODE_ENV=development

# Welcome email (sent to waitlist signups). Set SEND_WELCOME_EMAIL=false to disable.
# REPLY_TO_EMAIL=hello@searchlyst.com
# COMPANY_ADDRESS=Your physical address for CAN-SPAM (e.g., "123 Main St, City, State ZIP")

# Redis (required for bulk welcome email jobs)
REDIS_URL=redis://localhost:6379
# Cooldown between each welcome email in ms (default 2500)
WELCOME_EMAIL_COOLDOWN_MS=2500

# Set ALLOW_ADMIN_SETUP=true only when creating your first admin user, then set to false
ALLOW_ADMIN_SETUP=false

# Perplexity API (writing style analysis) — optional
# PERPLEXITY_API_KEY=your_perplexity_api_key

# Google Gemini AI (for competitor suggestions, content generation)
GEMINI_API_KEY=your_gemini_api_key

# Firecrawl API (for website crawling and audit)
# FIRECRAWL_API_KEY=your_firecrawl_api_key

# Infatica Scraper API (for AI visibility tracking)
# INFATICA_API_KEY=your_infatica_api_key
# VISIBILITY_ENGINE_HARD_TIMEOUT_MS=100000

# Optional: Set a SETUP_TOKEN for extra security on the setup route
# SETUP_TOKEN=your_secure_setup_token

# YouTube Data API v3 — optional (Brand Hub → Sync social data)
# YOUTUBE_API_KEY=your_youtube_data_api_key
