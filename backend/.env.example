PORT=3000
# --- Local database (SQLite file, default for development) ---
# Path is relative to prisma/schema.prisma → creates backend/prisma/dev.db
# Keep this for a fully local, file-backed DB. Production on Render may use file:./prisma/data/prod.db (see render.yaml).
DATABASE_URL="file:./dev.db"

# Optional: prisma/seed.mjs default dev user + optional local admin (change in production seeds if you use them)
# DEV_SEED_EMAIL=harsh@gmail.com
# DEV_SEED_PASSWORD=harsh1234
# DEV_SEED_NAME=Harsh
# DEV_SEED_ADMIN_EMAIL=admin@local.dev
# DEV_SEED_ADMIN_PASSWORD=admin1234

FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-secret-key-change-this-in-production
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_app_password
NOTIFICATION_EMAIL=notifications@example.com
NODE_ENV=development

# Local-only: API listens on 127.0.0.1 and rejects non-loopback clients (default in development).
# Set BIND_LOCAL_ONLY=false if you need another device on your Wi‑Fi to hit this API.
BIND_LOCAL_ONLY=true
# HOST=127.0.0.1

# Welcome email (sent to waitlist signups). Set SEND_WELCOME_EMAIL=false to disable.
# REPLY_TO_EMAIL=hello@searchlyst.com
# COMPANY_ADDRESS=Your physical address for CAN-SPAM (e.g., "123 Main St, City, State ZIP")

# Redis — Bull welcome-email queue only runs when REDIS_ENABLED=true
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
WELCOME_EMAIL_COOLDOWN_MS=2500

# Set ALLOW_ADMIN_SETUP=true only when creating your first admin user, then set to false
ALLOW_ADMIN_SETUP=false

# Perplexity API (writing style analysis) — optional
# PERPLEXITY_API_KEY=your_perplexity_api_key

# Google Gemini AI (for competitor suggestions, content generation)
GEMINI_API_KEY=your_gemini_api_key
# Optional model override (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.0-flash
# Onboarding competitor step: default is fast (no Google Search grounding). Set true for slower, web-backed suggestions.
# GEMINI_ONBOARDING_GROUNDING=false

# Firecrawl API (for website crawling and audit)
# FIRECRAWL_API_KEY=your_firecrawl_api_key

# Infatica Scraper API (for AI visibility tracking)
# INFATICA_API_KEY=your_infatica_api_key
# VISIBILITY_ENGINE_HARD_TIMEOUT_MS=100000
# Optional: cap rows in sourceDomains.topDomains (default: unlimited). Example: SOURCE_DOMAINS_MAX=500
# Max citation URLs stored per engine response (default 80, max 200). Example: MAX_CITATIONS_PER_RUN=100

# Optional: Set a SETUP_TOKEN for extra security on the setup route
# SETUP_TOKEN=your_secure_setup_token

# Optional: require this header (X-Export-Secret) for GET /api/admin/export-database in addition to admin JWT
# DATA_EXPORT_SECRET=long-random-string

# YouTube Data API v3 — optional (Brand Hub → Sync social data)
# YOUTUBE_API_KEY=your_youtube_data_api_key

# --- Production (NODE_ENV=production) ---
# TRUST_PROXY=true          # Behind nginx / cloud load balancer (correct IPs + rate limits)
# API_RATE_LIMIT_MAX=500    # Per-IP requests per 15 min window for /api (default 500 prod)
# JSON_BODY_LIMIT=512kb     # Max JSON body size
# LOG_HTTP=1                # Log each HTTP request (off by default in production)
