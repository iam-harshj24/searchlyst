generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String?
  auth_provider String    @default("local")
  google_id     String?   @unique
  name          String
  role_type     String?   @default("founder")
  onboarded     Boolean   @default(false)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())
  projects        Project[]
  auditJobs       AuditJob[]
  visibilityScans VisibilityScan[]
  contents        Content[]

  @@index([email])
  @@map("users")
}

model AdminUser {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  name          String
  created_at    DateTime? @default(now())
  last_login    DateTime?

  @@index([email])
  @@map("admin_users")
}

model waitlist {
  id          Int       @id @default(autoincrement())
  full_name   String
  email       String    @unique
  website_url String?
  source      String?
  status      String?   @default("pending")
  created_at  DateTime? @default(now())
  updated_at  DateTime? @default(now())

  @@index([email])
  @@index([status])
}

model Project {
  id               Int              @id @default(autoincrement())
  userId           Int
  brandName        String
  domain           String
  industry         String?
  companySize      String?
  location         String?
  trackingLocations String?
  language         String?
  reach            String?
  competitors      String?
  target_audience  String?
  social_linkedin  String?
  social_instagram String?
  social_substack  String?
  social_reddit    String?
  social_twitter   String?
  social_youtube   String?
  social_quora     String?
  social_tiktok    String?
  socialIngestSnapshot String?
  created_at       DateTime?        @default(now())
  updated_at       DateTime?        @default(now())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibilityScans  VisibilityScan[]
  auditJobs        AuditJob[]
  contents         Content[]

  @@unique([userId, domain])
  @@index([userId])
  @@map("projects")
}

model Content {
  id         Int      @id @default(autoincrement())
  userId     Int
  projectId  Int?
  topic      String
  platform   String   @default("Blog")
  title      String
  payload    String
  status     String   @default("draft")
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("contents")
}

model AuditJob {
  id         String   @id
  userId     Int
  projectId  Int?
  url        String
  status     String   @default("pending")
  progress   String?
  results    String?
  error      String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("audit_jobs")
}

model VisibilityScan {
  id         String   @id
  userId     Int
  projectId  Int?
  brandName  String
  domain     String
  industry   String?
  status     String   @default("pending")
  progress   String?
  allRuns    String?
  results    String?
  error      String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([projectId, created_at])
  @@map("visibility_scans")
}

model VisibilityDailySnapshot {
  id                    Int      @id @default(autoincrement())
  scanId                String   @unique
  userId                Int
  projectId             Int?
  brandName             String
  domain                String
  scanDate              DateTime
  
  overallScore          Float?
  visibilityScore       Float?
  sovScore              Float?
  positionScore         Float?
  sentimentScore        Float?
  
  totalRuns             Int?
  uniquePrompts         Int?
  mentionedIn           Int?
  
  promptCoverage        Float?
  promptsReached        Int?
  totalPrompts          Int?
  industryRank          Int?
  sentimentTrendPct     Float?
  effortTrendPct        Float?
  
  brandSov              Float?
  brandMentions         Int?
  brandAvgPosition      Float?
  brandSentiment        Float?
  totalEntityMentions   Int?
  
  sentimentPositivePct  Float?
  sentimentNeutralPct   Float?
  sentimentNegativePct  Float?
  sentimentPositiveCount Int?
  sentimentNeutralCount  Int?
  sentimentNegativeCount Int?
  sentimentIndex         Float?
  sentimentTotal         Int?
  
  perplexityScore       Float?
  perplexityRuns        Int?
  perplexityMentions    Int?
  geminiScore           Float?
  geminiRuns            Int?
  geminiMentions        Int?
  chatgptScore          Float?
  chatgptRuns           Int?
  chatgptMentions       Int?
  googleAIScore         Float?
  googleAIRuns          Int?
  googleAIMentions      Int?
  
  totalCitations        Int?
  totalCitedUrls        Int?
  
  created_at            DateTime @default(now())
  
  @@index([userId, scanDate])
  @@index([projectId, scanDate])
  @@index([domain, scanDate])
  @@index([scanDate])
  @@map("visibility_daily_snapshots")
}

model CompetitorDailySnapshot {
  id               Int      @id @default(autoincrement())
  scanId           String
  userId           Int
  projectId        Int?
  brandDomain      String
  scanDate         DateTime
  
  competitorName   String
  competitorDomain String?
  isTargetBrand    Boolean  @default(false)
  
  sov              Float?
  mentions         Int?
  avgPosition      Float?
  sentiment        Float?
  promptCoverage   Float?
  industryRank     Int?
  sentimentIndex   Float?
  
  created_at       DateTime @default(now())
  
  @@index([scanId])
  @@index([userId, scanDate])
  @@index([projectId, scanDate])
  @@index([brandDomain, competitorName, scanDate])
  @@map("competitor_daily_snapshots")
}

model EngineDailySnapshot {
  id         Int      @id @default(autoincrement())
  scanId     String
  userId     Int
  projectId  Int?
  domain     String
  scanDate   DateTime
  engine     String
  score      Float?
  runs       Int?
  mentions   Int?
  created_at DateTime @default(now())

  @@index([scanId])
  @@index([userId, engine, scanDate])
  @@index([projectId, engine, scanDate])
  @@map("engine_daily_snapshots")
}

model CategoryDailySnapshot {
  id          Int      @id @default(autoincrement())
  scanId      String
  userId      Int
  projectId   Int?
  domain      String
  scanDate    DateTime
  category    String
  score       Float?
  mentioned   Int?
  total       Int?
  created_at  DateTime @default(now())

  @@index([scanId])
  @@index([userId, category, scanDate])
  @@index([projectId, category, scanDate])
  @@map("category_daily_snapshots")
}

model CitationDailySnapshot {
  id              Int      @id @default(autoincrement())
  scanId          String
  userId          Int
  projectId       Int?
  brandDomain     String
  scanDate        DateTime
  citedDomain     String
  category        String?
  count           Int      @default(0)
  uniqueUrls      Int?
  isTargetBrand   Boolean  @default(false)
  isCompetitor    Boolean  @default(false)
  created_at      DateTime @default(now())

  @@index([scanId])
  @@index([userId, scanDate])
  @@index([projectId, scanDate])
  @@index([brandDomain, citedDomain, scanDate])
  @@map("citation_daily_snapshots")
}

model AuditDailySnapshot {
  id           Int      @id @default(autoincrement())
  auditId      String   @unique
  userId       Int
  projectId    Int?
  url          String
  domain       String
  auditDate    DateTime
  overallScore Float?
  seoScore     Float?
  perfScore    Float?
  a11yScore    Float?
  issuesTotal  Int?
  crawledPages Int?
  created_at   DateTime @default(now())

  @@index([userId, auditDate])
  @@index([projectId, auditDate])
  @@index([domain, auditDate])
  @@map("audit_daily_snapshots")
}

model ContentDailyStat {
  id         Int      @id @default(autoincrement())
  userId     Int
  projectId  Int?
  statDate   DateTime
  platform   String   @default("Blog")
  itemsCount Int      @default(0)
  published  Int      @default(0)
  draft      Int      @default(0)
  archived   Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([userId, projectId, statDate, platform])
  @@index([userId, statDate])
  @@index([projectId, statDate])
  @@map("content_daily_stats")
}
