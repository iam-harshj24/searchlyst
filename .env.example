# Frontend environment variables
# Copy to .env.local for local development

# API base URL - REQUIRED for production deployment
# Set this in your deployment platform (Vercel, Netlify, etc.) to your backend URL
# Examples:
#   - Same domain: https://www.searchlyst.com/api (if /api is proxied to backend)
#   - Separate API: https://api.searchlyst.com/api
VITE_API_BASE_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
PORT=3000
# Google Cloud SQL - use your own connection string (never commit real credentials)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_app_password
NOTIFICATION_EMAIL=notifications@example.com
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# JWT Authentication — generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-secret

# Perplexity API (writing style analysis) — optional
# PERPLEXITY_API_KEY=your_perplexity_api_key
ALLOW_ADMIN_SETUP=true

# Google Gemini AI (for competitor suggestions, content generation)
GEMINI_API_KEY=your_gemini_api_key

# Firecrawl API (for website crawling and audit)
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key

# Infatica Scraper API (for AI visibility tracking - Perplexity, Gemini, Google SERP)
INFATICA_API_KEY=your_infatica_api_key
# Optional Perplexity tuning (defaults: 95s timeout, 2 retries, 1 concurrent worker, 360s scan hard cap)
# INFATICA_PERPLEXITY_TIMEOUT_MS=95000
# INFATICA_PERPLEXITY_MAX_RETRIES=2
# INFATICA_PERPLEXITY_TRY_LIGHT_FIRST=false
# VISIBILITY_PERPLEXITY_CONCURRENCY=1
# VISIBILITY_PERPLEXITY_HARD_TIMEOUT_MS=360000
REDIS_URL=redis://localhost:6379
WELCOME_EMAIL_COOLDOWN_MS=2500
