# Used automatically when you run: vite build  or  npm run deploy:firebase
# Copy to .env.production and fill in ( .env.production is gitignored )
#
# Required for Firebase Hosting (or any static host): without this, the app calls /api on the
# same origin as the site, which does not exist on Firebase — set your Render (or other) API URL.

# Public URL of your Express API (must end with /api)
VITE_API_BASE_URL=https://your-backend-host.example.com/api

# Same OAuth Web Client ID as in backend GOOGLE_CLIENT_ID (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
