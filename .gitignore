#env
.env
.env.*
!.env.example

# Deployment (contains secrets)
deploy.config
*.sh
!backend/scripts/entrypoint.sh
!infra/**/*.sh
*.md
!README.md
!DEPLOY.md
!docs/PROJECT_AUDIT_REPORT.md
!infra/**/*.md

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Keep .terraform.lock.hcl in version control - pins provider versions for reproducibility.
# tfvars typically contain secrets — block all by default, then allow committed env files
*.tfvars
*.tfvars.json
!infra/terraform/envs/*.tfvars
!infra/terraform/terraform.tfvars.example

# Integration test artifacts (produced by `make buildup-it`)
.appdata/
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
test-results
playwright-report
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env